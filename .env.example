NODE_ENV=development
PORT=4002
SERVICE_NAME=nest-boiler-plate
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

JWT_TOKEN_KEY=change-me
JWT_EXPIRES_IN=7d

DATABASE_LINK=mongodb://localhost:27017
DATABASE_NAME=nest_boiler_plate

# Mailgun (used for OTP, password reset and notification emails)
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
MAIL_FROM=no-reply@example.com

# Email branding
APP_NAME=Nest Boiler Plate
SUPPORT_EMAIL=support@example.com
EMAIL_LOGO_URL=
